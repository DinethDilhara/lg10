# Local demo only. Copy to .env and set a password before starting Compose.
POSTGRES_DB=lgten
POSTGRES_USER=lgten
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
OPENSEARCH_PORT=9200
KAFKA_PORT=19092
FLUENT_BIT_PORT=2020
CONNECTOR_PORT=8081

# Optional bootstrap origin. Dashboard registration can replace it.
# SOURCE_OPENSEARCH_URL=http://host.docker.internal:9200
SOURCE_INDEX=lg-ten-logs-v1
SOURCE_ID=demo
SOURCE_USERNAME=
SOURCE_PASSWORD=
POLL_OVERLAP=30s
ALLOWED_LATENESS_SECONDS=35

# Step 4: add the key to ignored .env only; LangSmith is not used.
OPENAI_API_KEY=
LLM_MODEL=gpt-6.1-terra
INVESTIGATION_TOKEN_BUDGET=300000

# Step 5: API and permitted browser/source origins; no OpenAI key is passed to API.
API_PORT=8000
DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SOURCE_ALLOWED_HOSTS=host.docker.internal

# Optional Gemini provider for manual investigations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
INVESTIGATION_AUTO_QUEUE=false

# Dataset path relative to datasets/. Replay is started manually.
BGL_DATASET=raw/bgl/BGL_2k.log
BGL_REPLAY_RATE=20
