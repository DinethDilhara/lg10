  "components": {
    "schemas": {
      "ActivityBucket": {
        "properties": {
          "time": {
            "type": "string",
            "format": "date-time",
            "title": "Time"
          },
          "count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "time",
          "count"
        ],
        "title": "ActivityBucket"
      },
      "Anomalies": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AnomalyView"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "Anomalies"
      },
      "AnomalyView": {
        "properties": {
          "anomaly": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://lg-ten.local/contracts/v1/anomaly.schema.json",
            "properties": {
              "schema_version": {
                "const": "1.0.0"
              },
              "anomaly_id": {
                "type": "string",
                "maxLength": 256,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
              },
              "source_id": {
                "type": "string",
                "maxLength": 256,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
              },
              "window_start": {
                "type": "string",
                "pattern": "Z$",
                "format": "date-time"
              },
              "window_end": {
                "type": "string",
                "pattern": "Z$",
                "format": "date-time"
              },
              "score": {
                "type": "number"
              },
              "model_version": {
                "type": "string",
                "minLength": 1
              },
              "feature_summary": {
                "properties": {
                  "event_count": {
                    "type": "integer",
                    "minimum": 1.0
                  },
                  "error_count": {
                    "type": "integer",
                    "minimum": 0.0
                  },
                  "error_ratio": {
                    "type": "number",
                    "maximum": 1.0,
                    "minimum": 0.0
                  },
                  "unique_message_count": {
                    "type": "integer",
                    "minimum": 1.0
                  },
                  "event_time_start": {
                    "type": "string",
                    "pattern": "Z$",
                    "format": "date-time"
                  },
                  "event_time_end": {
                    "type": "string",
                    "pattern": "Z$",
                    "format": "date-time"
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "event_count",
                  "error_count",
                  "error_ratio",
                  "unique_message_count",
                  "event_time_start",
                  "event_time_end"
                ]
              },
              "log_ids": {
                "items": {
                  "type": "string",
                  "maxLength": 256,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                },
                "type": "array",
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "schema_version",
              "anomaly_id",
              "source_id",
              "window_start",
              "window_end",
              "score",
              "model_version",
              "feature_summary",
              "log_ids"
            ],
            "title": "LG Ten anomaly v1"
          },
          "investigation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Investigation Id"
          },
          "investigation_status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "pending",
                  "running",
                  "completed",
                  "inconclusive",
                  "failed"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Investigation Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "anomaly",
          "investigation_id",
          "investigation_status",
          "created_at"
        ],
        "title": "AnomalyView"
      },
      "ConnectionTest": {
        "properties": {
          "connected": {
            "type": "boolean",
            "title": "Connected"
          },
          "source_id": {
            "type": "string",
            "title": "Source Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "connected",
          "source_id"
        ],
        "title": "ConnectionTest"
      },
      "Evidence": {
        "properties": {
          "source_id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "title": "Source Id"
          },
          "index": {
            "type": "string",
            "title": "Index"
          },
          "event_id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "title": "Event Id"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "excerpt": {
            "type": "string",
            "title": "Excerpt"
          },
          "log": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://lg-ten.local/contracts/v1/log.schema.json",
            "properties": {
              "schema_version": {
                "const": "1.0.0"
              },
              "event_id": {
                "type": "string",
                "maxLength": 256,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
              },
              "source_id": {
                "type": "string",
                "maxLength": 256,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
              },
              "event_time": {
                "type": "string",
                "pattern": "Z$",
                "format": "date-time"
              },
              "ingested_at": {
                "type": "string",
                "pattern": "Z$",
                "format": "date-time"
              },
              "host": {
                "type": "string",
                "minLength": 1
              },
              "service": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": [
                  "TRACE",
                  "DEBUG",
                  "INFO",
                  "WARN",
                  "ERROR",
                  "FATAL",
                  "UNKNOWN"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "attributes": {
                "type": "object"
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "schema_version",
              "event_id",
              "source_id",
              "event_time",
              "ingested_at",
              "host",
              "service",
              "severity",
              "message"
            ],
            "title": "LG Ten log v1"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "index",
          "event_id",
          "timestamp",
          "excerpt",
          "log"
        ],
        "title": "Evidence"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "api": {
            "type": "string",
            "const": "ok",
            "title": "Api",
            "default": "ok"
          },
          "postgres": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Postgres"
          },
          "connector": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Connector"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "postgres",
          "connector"
        ],
        "title": "Health"
      },
      "InvestigationLink": {
        "properties": {
          "investigation_id": {
            "type": "string",
            "title": "Investigation Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "completed",
              "inconclusive",
              "failed"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "investigation_id",
          "status"
        ],
        "title": "InvestigationLink"
      },
      "InvestigationRequest": {
        "properties": {
          "provider": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "gpt",
                  "gemini"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "InvestigationRequest"
      },
      "InvestigationView": {
        "properties": {
          "investigation_id": {
            "type": "string",
            "title": "Investigation Id"
          },
          "anomaly_id": {
            "type": "string",
            "title": "Anomaly Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "completed",
              "inconclusive",
              "failed"
            ],
            "title": "Status"
          },
          "report": {
            "anyOf": [
              {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "$id": "https://lg-ten.local/contracts/v1/investigation.schema.json",
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "completed"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "hypotheses": {
                          "type": "array",
                          "minItems": 1
                        },
                        "evidence": {
                          "type": "array",
                          "minItems": 1
                        },
                        "verification": {
                          "properties": {
                            "status": {
                              "const": "supported"
                            },
                            "checks": {
                              "type": "array",
                              "minItems": 1
                            }
                          },
                          "type": "object"
                        },
                        "agent_steps": {
                          "type": "array",
                          "minItems": 1
                        }
                      }
                    }
                  }
                ],
                "properties": {
                  "schema_version": {
                    "const": "1.0.0"
                  },
                  "investigation_id": {
                    "type": "string",
                    "maxLength": 256,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                  },
                  "anomaly_id": {
                    "type": "string",
                    "maxLength": 256,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                  },
                  "status": {
                    "enum": [
                      "pending",
                      "running",
                      "completed",
                      "inconclusive",
                      "failed"
                    ]
                  },
                  "hypotheses": {
                    "items": {
                      "properties": {
                        "hypothesis_id": {
                          "type": "string",
                          "maxLength": 256,
                          "minLength": 1,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                        },
