{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lg-ten.local/contracts/v1/investigation.schema.json",
  "title": "LG Ten investigation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "investigation_id",
    "anomaly_id",
    "status",
    "hypotheses",
    "evidence",
    "verification",
    "agent_steps",
    "duration_ms"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "investigation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "anomaly_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "completed",
        "inconclusive",
        "failed"
      ]
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id",
          "claim",
          "evidence_ids",
          "confidence",
          "uncertainty"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "uncertainty": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "source_id",
          "index",
          "event_id",
          "timestamp",
          "excerpt"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "index": {
            "type": "string",
            "minLength": 1
          },
          "event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "excerpt": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checks"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "supported",
            "unsupported",
            "inconclusive",
            "failed"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hypothesis_id",
              "citation_valid",
              "semantic_support",
              "summary"
            ],
            "properties": {
              "hypothesis_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
              },
              "citation_valid": {
                "type": "boolean"
              },
              "semantic_support": {
                "enum": [
                  "supported",
                  "unsupported",
                  "uncertain"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "agent_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "execution_event_id",
          "sequence",
          "agent",
          "status",
          "occurred_at",
          "summary"
        ],
        "properties": {
          "execution_event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "agent": {
            "enum": [
              "supervisor",
              "retrieval",
              "analysis",
              "verification"
            ]
          },
          "status": {
            "enum": [
              "started",
              "completed",
              "failed"
            ]
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "hypotheses": {
            "minItems": 1,
            "type": "array"
          },
          "evidence": {
            "minItems": 1,
            "type": "array"
          },
          "verification": {
            "properties": {
              "status": {
                "const": "supported"
              },
              "checks": {
                "minItems": 1,
                "type": "array"
              }
            },
            "type": "object"
          },
          "agent_steps": {
            "minItems": 1,
            "type": "array"
          }
        }
      }
    }
  ]
}
