{
  "index_patterns": [
    "lg-ten-logs-v1*"
  ],
  "priority": 100,
  "version": 1,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "schema_version": {
          "type": "keyword"
        },
        "event_id": {
          "type": "keyword"
        },
        "source_id": {
          "type": "keyword"
        },
        "host": {
          "type": "keyword"
        },
        "service": {
          "type": "keyword"
        },
        "severity": {
          "type": "keyword"
        },
        "event_time": {
          "type": "date",
          "format": "strict_date_time"
        },
        "ingested_at": {
          "type": "date",
          "format": "strict_date_time"
        },
        "message": {
          "type": "text"
        },
        "attributes": {
          "type": "object",
          "enabled": false
        }
      }
    }
  }
}
